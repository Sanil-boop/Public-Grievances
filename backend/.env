# MongoDB connection string
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/nagarseva

# For MongoDB Atlas (cloud), replace with your connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nagarseva?retryWrites=true&w=majority

# JWT Secret — change this to any random string in production
JWT_SECRET=nagarseva-super-secret-key-2024-change-me

# Server port
PORT=5000
